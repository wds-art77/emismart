# Address that receives "request lawyer review" e-mails (mailto link on the public tracker and escalation mails).
NEXT_PUBLIC_REVIEW_EMAIL=weds@desaeger.be
REVIEW_EMAIL=weds@desaeger.be

# Public URL of the deployment (used in e-mail links).
NEXT_PUBLIC_APP_URL=https://www.emismart.com

# Secret used to sign sessions and local upload links. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Managed Postgres in the EU (Supabase or Neon, region Frankfurt). Without it, development uses an embedded database under .data/.
DATABASE_URL=

# S3-compatible document bucket in the EU (Supabase Storage S3 endpoint, Cloudflare R2 EU or AWS eu-central-1).
# Without these, development stores files under .data/uploads.
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Transactional mail (Resend). Without a key, mail is printed to the server log and sign-in links are shown on screen.
RESEND_API_KEY=
MAIL_FROM=Emismart <noreply@emismart.com>

# Protects the daily reminder cron endpoint.
CRON_SECRET=
